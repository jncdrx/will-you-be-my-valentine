# Supabase PostgreSQL Database Password
DATABASE_PASSWORD=

# Supabase Client Configuration (frontend-safe; never put a service-role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: admin email hint used ONLY to pre-fill the admin login form.
# The actual admin authorization is verified from the database (profiles.role = 'admin'),
# NOT from this variable.
VITE_ADMIN_EMAIL=

# Optional: allowed recipient email for the private site gate (Angel).
# If set, overrides the value stored in site_settings.allowed_email.
VITE_ALLOWED_EMAIL=
{
  "name": "will-you-be-my-valentine",
  "homepage": "https://jncdrx.github.io/will-you-be-my-valentine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"vite,api\" --prefix-colors \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:vite": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc && vite build",
    "deploy": "vite build && gh-pages -d dist",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite --open",
    "clean": "rimraf node_modules/.vite dist"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.30.0",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.563.0",
    "modern-screenshot": "^4.7.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^11.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "typewriter-effect": "^2.22.0",
    "use-sound": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.4",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.1.1",
    "pg": "^8.22.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
